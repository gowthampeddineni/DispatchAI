# ---- OpenAI (two-tier model routing) ----
OPENAI_API_KEY=sk-...
# small model: routing / extraction / agent position formation
DISPATCHAI_SMALL_MODEL=gpt-4o-mini
# large model: orchestrator synthesis / conflict resolution / fix suggestions
DISPATCHAI_LARGE_MODEL=gpt-4o
# llm mode: auto (use LLM when OPENAI_API_KEY set) | live (force) | rules (deterministic only)
DISPATCHAI_LLM_MODE=auto

# ---- LangSmith observability (auto-traces every agent + tool call) ----
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=dispatchai-poc
# legacy aliases some langchain versions read:
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=dispatchai-poc

# ---- Server ----
DISPATCHAI_HOST=127.0.0.1
DISPATCHAI_PORT=8000

# ---- Data ----
# SQLite database backing the MCP-style tool layer (created by: python main.py seed)
DISPATCHAI_DB=data/dispatchai.db
